# Non-secret Compose settings. Use a private .env copied beside compose.yaml.
HINDSIGHT_COMPOSE_PROJECT=hindsight-production
# Required: registry/name@sha256:<64 lowercase hex digits>; no mutable tag.
HINDSIGHT_IMAGE=
HINDSIGHT_RUNTIME_ENV_FILE=./private/runtime.env
HINDSIGHT_MIGRATION_ENV_FILE=./private/migration.env
HINDSIGHT_PG_CA_FILE=./private/postgres-ca.pem
HINDSIGHT_PG_PASSFILE=./private/postgres.pgpass
HINDSIGHT_MIGRATION_PASSFILE=./private/migration.pgpass
HINDSIGHT_DB_SCHEMA=hindsight
HINDSIGHT_EMBEDDING_DIMENSION=1024
HINDSIGHT_API_1_PORT=18889
HINDSIGHT_API_2_PORT=18890
# Set both before Compose config; IDs must differ across all active hosts.
HINDSIGHT_WORKER_1_ID=prod-host-a-worker-1
HINDSIGHT_WORKER_2_ID=prod-host-a-worker-2
