# Copy into an independent Mem0 checkout at deploy.handbook/.env.
# Populate private values locally. Never commit the completed file.
MEM0_COMPOSE_PROJECT=mem0-handbook
MEM0_API_PORT=18888
MEM0_DASHBOARD_PORT=13000
POSTGRES_PASSWORD=
JWT_SECRET=
OPENAI_API_KEY=
ADMIN_API_KEY=
AUTH_DISABLED=false
MEM0_TELEMETRY=false
POSTGRES_COLLECTION_NAME=memories
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
REQUEST_LOG_RETENTION_DAYS=30
