# Non-secret Compose settings. Copy to deploy.production/.env.
# Keep credentials in the separate private/runtime.env; do not commit either file.
MEM0_COMPOSE_PROJECT=mem0-production
# Required: reviewed registry/name@sha256:<64 lowercase hexadecimal digits>.
# A mutable tag or a source-commit-shaped tag is not a digest pin.
MEM0_IMAGE=
MEM0_RUNTIME_ENV_FILE=./private/runtime.env
MEM0_PG_CA_FILE=./private/postgres-ca.pem
MEM0_UID=10001
MEM0_GID=10001
MEM0_API_PORT=18888
# Reserved browser origin; no dashboard is started by this Compose file.
MEM0_DASHBOARD_URL=https://mem0-admin.example.invalid
